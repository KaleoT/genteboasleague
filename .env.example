PORT=3000
HOST=127.0.0.1
DATABASE_PATH=./data/gbl.sqlite
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NODE_ENV=development

PUBLIC_BASE_URL=http://localhost:3000

# Recuperação de senha: log (contingência) ou smtp.
PASSWORD_RESET_TTL_MINUTES=15
# EMAIL_DRIVER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=

# Armazenamento local compartilhado (volume persistente na hospedagem)
UPLOADS_PATH=./uploads
